function tmf:bt/category
execute if score #cat tmf.tmp matches 1 run return run function tmf:bt/want_pickaxe
execute if score #cat tmf.tmp matches 2 run return run function tmf:bt/want_axe
execute if score #cat tmf.tmp matches 3 run return run function tmf:bt/want_shovel
execute if score #cat tmf.tmp matches 4 run return run function tmf:bt/want_hoe
execute if score #cat tmf.tmp matches 5 run return run function tmf:bt/want_shears
