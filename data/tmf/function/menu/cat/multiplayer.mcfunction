playsound minecraft:ui.button.click master @s ~ ~ ~ 0.4 1.4
data modify storage tmf:tmp d set value {dialog:{type:"minecraft:multi_action",title:{text:"TMF – Multiplayer",color:"gold",bold:true},body:[{type:"minecraft:plain_message",contents:{text:"Click a feature to switch it on or off for yourself. Hover for a description. 🔒 means an admin made it mandatory.",color:"gray"},width:340}],columns:2,pause:false,actions:[],exit_action:{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"/trigger tmf set 1"}}}}
execute if score #tpa tmf.cfg matches 1.. if score #lock_tpa tmf.cfg matches 1 run data modify storage tmf:tmp d.dialog.actions append value {label:{text:"",extra:[{text:"Teleport Requests: ",color:"white"},{text:"On 🔒",color:"dark_green"}]},tooltip:{text:"Ask another player from the menu to teleport you to them, or them to you. They have 60 seconds to accept. (Locked by an admin.)"},width:200,action:{type:"minecraft:run_command",command:"/trigger tmf set 156"}}
execute if score #tpa tmf.cfg matches 1.. unless score #lock_tpa tmf.cfg matches 1 if entity @s[tag=!tmf.off.tpa] run data modify storage tmf:tmp d.dialog.actions append value {label:{text:"",extra:[{text:"Teleport Requests: ",color:"white"},{text:"ON",color:"green"}]},tooltip:{text:"Ask another player from the menu to teleport you to them, or them to you. They have 60 seconds to accept."},width:200,action:{type:"minecraft:run_command",command:"/trigger tmf set 156"}}
execute if score #tpa tmf.cfg matches 1.. unless score #lock_tpa tmf.cfg matches 1 if entity @s[tag=tmf.off.tpa] run data modify storage tmf:tmp d.dialog.actions append value {label:{text:"",extra:[{text:"Teleport Requests: ",color:"white"},{text:"OFF",color:"red"}]},tooltip:{text:"Ask another player from the menu to teleport you to them, or them to you. They have 60 seconds to accept."},width:200,action:{type:"minecraft:run_command",command:"/trigger tmf set 156"}}
execute unless data storage tmf:tmp d.dialog.actions[0] run return run function tmf:menu/open
function tmf:util/show_dialog with storage tmf:tmp d
